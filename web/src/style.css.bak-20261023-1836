:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#dce5e9;background:#0b1118;font-synthesis:none}*{box-sizing:border-box}body{margin:0}button,input{font:inherit}button{cursor:pointer;border:1px solid #34434f;background:#17232d;color:#e1edf1;border-radius:7px;padding:11px 15px}button:hover{background:#223542;border-color:#5f8796}button:focus-visible,input:focus-visible{outline:2px solid #7ce2c5;outline-offset:3px}header{height:80px;border-bottom:1px solid #22303c;display:flex;align-items:center;justify-content:space-between;padding:0 5vw}.brand{color:#7ce2c5;text-decoration:none;font-size:27px;display:flex;align-items:center;gap:12px}.brand span{font-size:14px;letter-spacing:3px;font-weight:700}.pill{font-size:10px;letter-spacing:1px;border:1px solid #364a58;padding:6px 10px;border-radius:30px;color:#a8bdc6}main{max-width:1440px;padding:48px 5vw 24px;margin:auto}.intro{max-width:850px}.eyebrow{font-size:10px;letter-spacing:2px;color:#7ce2c5;font-weight:700;margin:0 0 14px}h1{font-size:clamp(36px,4.5vw,64px);font-weight:550;letter-spacing:-2.8px;line-height:1.05;margin:0 0 20px}p{line-height:1.6}.intro>p:last-child{color:#91a5b3;max-width:700px;font-size:17px}.notice{margin:32px 0 24px;padding:15px 18px;border:1px solid #4e4931;background:#242319;color:#c3bea5;font-size:12px;line-height:1.6}.notice b{color:#e4d49b;letter-spacing:1px;margin-right:15px}.workspace{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,1fr);gap:22px}.card{border:1px solid #263642;border-radius:12px;background:#101b25;padding:24px;min-width:0}.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:22px}.section-head span{font-size:11px;color:#91a5b3}h2{font-size:20px;font-weight:550;margin:0 0 20px;letter-spacing:-.4px}.section-head h2{margin:0}h3{font-size:13px;font-weight:600;margin:0}.arms{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:24px}.arm{text-align:left;padding:14px 10px;display:flex;gap:10px;align-items:flex-start}.arm>b{font-size:23px;color:#718a98}.arm span{font-size:11px;line-height:1.3}.arm small{display:block;color:#7e96a4;margin-top:7px;font-size:9px}.arm.selected{border-color:#7ce2c5;background:#17332f}.arm.selected>b{color:#7ce2c5}label{display:block;font-size:11px;color:#8fa5b3;margin:13px 0}input{display:block;width:100%;background:#0b151e;border:1px solid #2d414e;border-radius:6px;padding:11px;color:#c8d8e0;margin-top:7px;font-size:12px}.scope{display:flex;align-items:center;gap:15px;padding:30px 0}.scope strong{text-transform:capitalize;font-size:18px;font-weight:500}.scope p{font-size:11px;color:#8fa5b3;margin:6px 0 0}.dot{width:11px;height:11px;border-radius:50%;background:#506270;flex-shrink:0}.dot.live{background:#7ce2c5;box-shadow:0 0 18px #7ce2c588}.signal{margin-left:auto;color:#547f78;white-space:nowrap;letter-spacing:3px}.actions{display:flex;flex-wrap:wrap;gap:8px}.actions button{font-size:11px}.primary{background:#7ce2c5;color:#0c2921;border-color:#7ce2c5}.primary:hover{background:#a2efd9;color:#0c2921}#error{font-size:12px;color:#f4ad9e;min-height:20px}details{border-top:1px solid #263642;border-bottom:1px solid #263642;padding:18px 0;margin-bottom:24px;font-size:11px;color:#94a9b5}summary{cursor:pointer;color:#bfd0d9}form{display:flex;align-items:end;gap:8px}form button{font-size:11px;white-space:nowrap}.conversation{min-height:180px;max-height:340px;overflow:auto}.conversation p{border-left:2px solid #577e7c;padding:10px 15px;background:#14252d;font-size:13px}.conversation .user{border-color:#8099bb}.empty{color:#637c8c;background:transparent!important;border:0!important}aside{display:grid;gap:20px;align-content:start}aside .card{padding:22px}.muted{font-size:11px;color:#8198a6;line-height:1.6;margin-bottom:0}pre{font:11px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;color:#a7c7c5;background:#0b151e;padding:13px;border-radius:6px;max-height:200px;overflow:auto}dl{display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:11px;line-height:1.5}dt{color:#8198a6}dd{margin:0;color:#c6d6dd;text-align:right}.trace{margin-top:24px}.trace .section-head{margin-bottom:5px}.trace button{font-size:11px}#trace{height:240px;overflow:auto;margin-top:20px;font:10px/1.8 ui-monospace,Consolas,monospace;color:#86a5b2}#trace>div{border-bottom:1px solid #1b2a34;overflow-wrap:anywhere;padding:5px}footer{font-size:10px;letter-spacing:.5px;color:#677e8d;padding:26px 0;text-align:center}@media(max-width:900px){.workspace{grid-template-columns:1fr}main{padding-top:32px}.signal{display:none}}@media(max-width:500px){header{padding:0 20px}.pill{font-size:8px}.card{padding:18px}.arms{grid-template-columns:1fr}.arm small{margin:0}.arm{align-items:center}.arm span{flex:1}h1{letter-spacing:-1.5px}.section-head{align-items:flex-start}}

select{width:100%;margin-top:7px;padding:11px;background:#0b151e;color:#c8d8e0;border:1px solid #2d414e;border-radius:6px;font:inherit}.mode-controls{border-bottom:1px solid #263642;padding-bottom:10px}.mode-controls input[type=checkbox]{display:inline-block;width:auto;margin:0 8px 0 0}#live-consent-label{line-height:1.7;color:#d8c79b}
